<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net8.0-android;net8.0-windows10.0.19041.0</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('linux'))">net8.0-android</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>ReceiptScannerLite</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Display name -->
        <ApplicationTitle>Receipt Scanner Lite</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.receiptscannerlite.app</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon - Commented out: files don't exist yet -->
        <!-- <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" /> -->

        <!-- Splash Screen - Commented out: file doesn't exist yet -->
        <!-- <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" /> -->

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.3" />
        <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="8.0.3" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="8.0.3" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
        <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
        <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
        <PackageReference Include="SkiaSharp" Version="2.88.7" />
        <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="2.88.7" />
        <PackageReference Include="Tesseract" Version="5.2.0" />
    </ItemGroup>

    <!-- Android specific -->
    <ItemGroup Condition="$(TargetFramework.StartsWith('net8.0-android'))">
        <AndroidAsset Include="Assets\tessdata\**" />
        <!-- Explicitly exclude Windows platform files when building for Android -->
        <Compile Remove="Platforms\Windows\**\*.cs" />
        <Compile Remove="Platforms\Windows\**\*.xaml.cs" />
        <MauiXaml Remove="Platforms\Windows\**\*.xaml" />
        <None Include="Platforms\Windows\**\*" />
    </ItemGroup>

    <!-- Windows specific -->
    <ItemGroup Condition="$(TargetFramework.StartsWith('net8.0-windows'))">
        <!-- Remove from default Content items to avoid NETSDK1022 duplicates -->
        <Content Remove="Assets\tessdata\**" />
        <!-- Re-add as Content with copy settings -->
        <Content Include="Assets\tessdata\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <!-- Explicitly exclude Android platform files when building for Windows -->
        <Compile Remove="Platforms\Android\**\*.cs" />
        <None Include="Platforms\Android\**\*" />
    </ItemGroup>

</Project>
