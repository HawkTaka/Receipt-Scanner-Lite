@page "/capture"
@inject CaptureViewModel ViewModel
@inject NavigationManager NavigationManager
@inject INavigationService NavigationService
@inject IImageService ImageService

<div class="page-container">
    <h2>Capture Receipt</h2>

    <div class="capture-actions">
        <button class="btn btn-primary" @onclick="CapturePhoto" disabled="@ViewModel.IsProcessing">
            📷 Take Photo
        </button>
        <button class="btn btn-secondary" @onclick="PickPhoto" disabled="@ViewModel.IsProcessing">
            🖼️ Pick from Gallery
        </button>
    </div>

    @if (!string.IsNullOrEmpty(ViewModel.CapturedImagePath))
    {
        <div class="image-preview">
            <h3>Preview</h3>
            @if (!string.IsNullOrEmpty(_imageDataUrl))
            {
                <img src="@_imageDataUrl" alt="Receipt" class="preview-image" />
            }
            else if (_isLoadingImage)
            {
                <div class="spinner"></div>
                <p>Loading image...</p>
            }
            else
            {
                <p>Unable to load image preview</p>
            }

            <div class="preview-actions">
                <button class="btn btn-primary" @onclick="ProcessImage" disabled="@ViewModel.IsProcessing">
                    🔍 Run OCR
                </button>
                <button class="btn btn-danger" @onclick="ClearImage" disabled="@ViewModel.IsProcessing">
                    ❌ Clear
                </button>
            </div>
        </div>
    }

    @if (ViewModel.IsProcessing)
    {
        <div class="processing-indicator">
            <div class="spinner"></div>
            <p>@ViewModel.StatusMessage</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(ViewModel.StatusMessage) && !ViewModel.IsProcessing)
    {
        <div class="status-message">
            @ViewModel.StatusMessage
        </div>
    }
</div>

@code {
    private string? _imageDataUrl;
    private bool _isLoadingImage;

    protected override void OnInitialized()
    {
        // Initialize navigation service
        if (NavigationService is NavigationService navService)
        {
            navService.Initialize(NavigationManager);
        }

        // Subscribe to ViewModel property changes
        ViewModel.PropertyChanged += async (s, e) =>
        {
            if (e.PropertyName == nameof(ViewModel.CapturedImagePath))
            {
                await LoadImageAsync();
            }
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(ViewModel.CapturedImagePath))
        {
            await LoadImageAsync();
        }
    }

    private async Task LoadImageAsync()
    {
        if (string.IsNullOrEmpty(ViewModel.CapturedImagePath))
        {
            _imageDataUrl = null;
            return;
        }

        _isLoadingImage = true;
        StateHasChanged();

        try
        {
            _imageDataUrl = await ImageService.GetImageDataUrlAsync(ViewModel.CapturedImagePath);
        }
        finally
        {
            _isLoadingImage = false;
            StateHasChanged();
        }
    }

    private async Task CapturePhoto()
    {
        await ViewModel.CapturePhotoCommand.ExecuteAsync(null);
    }

    private async Task PickPhoto()
    {
        await ViewModel.PickPhotoCommand.ExecuteAsync(null);
    }

    private async Task ProcessImage()
    {
        await ViewModel.ProcessImageCommand.ExecuteAsync(null);
    }

    private void ClearImage()
    {
        ViewModel.ClearImageCommand.Execute(null);
        _imageDataUrl = null;
    }
}

