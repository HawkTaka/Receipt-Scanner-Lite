<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ReceiptScannerLite.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ReceiptScannerLite"
    Title="Receipt Scanner Lite">

    <TabBar>
        <ShellContent
            Title="Capture"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="capture" />

        <ShellContent
            Title="Receipts"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="receipts" />

        <ShellContent
            Title="Insights"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="insights" />

        <ShellContent
            Title="Export"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="export" />
    </TabBar>

</Shell>
